NEXT_PUBLIC_API_HOST=explorer.test-net.interlinklabs.org
NEXT_PUBLIC_API_PROTOCOL=https
NEXT_PUBLIC_STATS_API_HOST=https://explorer.test-net.interlinklabs.org/stats-api
NEXT_PUBLIC_NETWORK_NAME=Interlink Testnet
NEXT_PUBLIC_NETWORK_SHORT_NAME=Interlink
NEXT_PUBLIC_NETWORK_ID=27012026
NEXT_PUBLIC_NETWORK_CURRENCY_NAME=Interlink
NEXT_PUBLIC_NETWORK_CURRENCY_SYMBOL=ITL
NEXT_PUBLIC_NETWORK_CURRENCY_DECIMALS=18
NEXT_PUBLIC_API_BASE_PATH=/
NEXT_PUBLIC_APP_HOST=explorer.test-net.interlinklabs.org
NEXT_PUBLIC_APP_PROTOCOL=https
NEXT_PUBLIC_HOMEPAGE_CHARTS=['daily_txs']
NEXT_PUBLIC_VISUALIZE_API_HOST=https://explorer.test-net.interlinklabs.org/visualize-api
NEXT_PUBLIC_IS_TESTNET=true
NEXT_PUBLIC_API_WEBSOCKET_PROTOCOL=wss
# Required to enable blockchain interaction
# NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Disable third-party ad scripts (slise)
NEXT_PUBLIC_AD_BANNER_PROVIDER=none
NEXT_PUBLIC_AD_TEXT_PROVIDER=none

# Gas tracker — show Gwei instead of USD (no market price needed)
NEXT_PUBLIC_GAS_TRACKER_ENABLED=false
NEXT_PUBLIC_GAS_TRACKER_UNITS=["gwei"]
HOSTNAME=0.0.0.0
NEXT_PUBLIC_NETWORK_LOGO=https://public.interlinklabs.ai/1773546377791_logo-interlinkscan.png
NEXT_PUBLIC_NETWORK_LOGO_DARK=https://public.interlinklabs.ai/1773546377791_logo-interlinkscan.png
